{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgrlabs.dev/schemas/horizon/inspection-report-v1.json",
  "title": "Horizon Mod Inspection Report",
  "description": "Standard schema for Horizon mod package inspection, validation, and security analysis reports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_kind",
    "security_tier",
    "is_valid",
    "file",
    "identity",
    "compatibility",
    "signature",
    "diagnostics",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the report schema (e.g. '1.0.0')"
    },
    "package_kind": {
      "type": "string",
      "enum": [
        "content-mod",
        "native-mod",
        "modpack",
        "shader",
        "resource-pack",
        "unknown"
      ],
      "description": "Detected package kind."
    },
    "security_tier": {
      "type": "string",
      "enum": [
        "sandboxed-content",
        "unsandboxed-native",
        "configuration-only",
        "visual-shader",
        "asset-only",
        "unclassified"
      ],
      "description": "Security classification of the inspected package."
    },
    "is_valid": {
      "type": "boolean",
      "description": "True if error_count is 0 and package satisfies format and integrity rules."
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_path", "file_name", "size_bytes", "sha256"],
      "properties": {
        "file_path": { "type": "string" },
        "file_name": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex-encoded SHA-256 hash."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "game": { "type": ["string", "null"] },
        "api": { "type": ["string", "null"] },
        "api_level": { "type": ["integer", "null"] },
        "side": { "type": ["string", "null"], "enum": ["client", "server", "both", null] },
        "horizon_revision": { "type": ["string", "null"] },
        "mixins_revision": { "type": ["string", "null"] },
        "hooks_api": { "type": ["integer", "null"] }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "sha256", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unsigned",
            "signature-missing",
            "key-missing",
            "invalid"
          ]
        },
        "public_key": { "type": "string" },
        "signature_path": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "description": "Standardized uppercase diagnostic error code."
          },
          "message": { "type": "string" },
          "target": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "total_uncompressed_bytes",
        "error_count",
        "warning_count",
        "info_count"
      ],
      "properties": {
        "file_count": { "type": "integer", "minimum": 0 },
        "total_uncompressed_bytes": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "info_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
